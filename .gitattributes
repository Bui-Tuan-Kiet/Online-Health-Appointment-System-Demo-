# Normalize line endings for text files to LF
* text=auto eol=lf

# Ensure shell / script files are treated as text and use LF
*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Mark common binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Use Git LFS for large/binary assets (adjust patterns to your needs)
# These lines make Git treat matched files with the LFS filter.
*.psd filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text

# Prevent vendor or build dirs from being exported in archives (optional)
node_modules/ export-ignore
dist/ export-ignore
build/ export-ignore